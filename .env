# Threat Intelligence AI Platform Configuration
# Course: 23CSE528 - NoSQL Databases using MongoDB

# Database Configuration (Exercise 2 & 12)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=threat_intel_db

# LLM Backend Configuration (Appendix A.1)
# Primary engine: Ollama local Small Language Model (SLM)
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Vector Search & RAG (Exercise 17 & Appendix A.2)
