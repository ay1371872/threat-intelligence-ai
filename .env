TOP_K=4
CHUNK_SIZE=250

# Automated Scanner Bot Configuration
SCAN_INTERVAL_SECONDS=300
AUTO_SCAN_ENABLED=true
TARGET_PLATFORM=Windows

# Security & API Protection (Exercise 12)
API_SECRET_KEY=threat-intel-jwt-secret-ayush-24btlcl003
RATE_LIMIT_PER_MINUTE=60
